{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alizadesadig517-create/english-daily/schema/lesson.schema.json",
  "title": "English Daily lesson",
  "description": "One day's lesson. File name: content/YYYY-MM-DD.json (date in Asia/Baku). This is the contract between the daily content routine and the Android app (app/lib/models/lesson.dart).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "date", "level", "translationLanguage", "words", "grammar"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "translationLanguage": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "words": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/word" }
    },
    "story": { "$ref": "#/$defs/story" },
    "grammar": { "$ref": "#/$defs/grammar" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "translated": {
      "description": "An English sentence with its translation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "translation"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "translation": { "$ref": "#/$defs/text" }
      }
    },
    "partOfSpeech": {
      "enum": [
        "noun", "verb", "adjective", "adverb", "pronoun", "preposition",
        "conjunction", "determiner", "interjection", "phrasal verb", "idiom", "phrase"
      ]
    },
    "homonym": {
      "description": "A word spelled and/or pronounced the same but with an unrelated meaning.",
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "meaning", "translation"],
      "properties": {
        "word": { "$ref": "#/$defs/text" },
        "meaning": { "$ref": "#/$defs/text" },
        "translation": { "$ref": "#/$defs/text" }
      }
    },
    "sense": {
      "description": "One part of speech of a word. Synonyms, antonyms, homonyms and examples belong to this part of speech only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["partOfSpeech", "translation", "definition", "synonyms", "antonyms", "homonyms", "examples"],
      "properties": {
        "partOfSpeech": { "$ref": "#/$defs/partOfSpeech" },
        "translation": { "$ref": "#/$defs/text" },
        "definition": { "$ref": "#/$defs/text" },
        "synonyms": { "$ref": "#/$defs/stringList" },
        "antonyms": { "$ref": "#/$defs/stringList" },
        "homonyms": {
          "type": "array",
          "items": { "$ref": "#/$defs/homonym" }
        },
        "examples": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/translated" }
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "ipa", "senses"],
      "properties": {
        "word": { "type": "string", "pattern": "^[A-Za-z][A-Za-z' -]*$" },
        "ipa": { "type": "string", "pattern": "^/.+/$" },
        "senses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/sense" }
        }
      }
    },
    "glossaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "lemma", "partOfSpeech", "meaning", "translation"],
      "properties": {
        "term": { "$ref": "#/$defs/text" },
        "lemma": { "$ref": "#/$defs/text" },
        "partOfSpeech": { "$ref": "#/$defs/partOfSpeech" },
        "meaning": { "$ref": "#/$defs/text" },
        "translation": { "$ref": "#/$defs/text" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "titleTranslation", "paragraphs", "glossary"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "titleTranslation": { "$ref": "#/$defs/text" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sentences"],
            "properties": {
              "sentences": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/translated" }
              }
            }
          }
        },
        "glossary": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/glossaryEntry" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "translation"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "translation": { "$ref": "#/$defs/text" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prompt", "answer"],
      "properties": {
        "type": { "enum": ["choice", "text"] },
        "prompt": { "$ref": "#/$defs/text" },
        "promptTranslation": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/text" }
        },
        "answer": { "$ref": "#/$defs/text" },
        "acceptedAnswers": { "$ref": "#/$defs/stringList" },
        "explanation": { "$ref": "#/$defs/text" },
        "explanationTranslation": { "$ref": "#/$defs/text" }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "topicTranslation", "explanation", "explanationTranslation", "rules", "examples", "exercise"],
      "properties": {
        "topic": { "$ref": "#/$defs/text" },
        "topicTranslation": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" },
        "explanationTranslation": { "$ref": "#/$defs/text" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        },
        "examples": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/translated" }
        },
        "exercise": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instructions", "instructionsTranslation", "questions"],
          "properties": {
            "instructions": { "$ref": "#/$defs/text" },
            "instructionsTranslation": { "$ref": "#/$defs/text" },
            "questions": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/question" }
            }
          }
        }
      }
    }
  }
}
